-- Q1. Details of all books: book id, title, publisher, author,
--     number of copies in each programme

SELECT B.BOOK_ID, B.TITLE, B.PUBLISHER_NAME, BA.AUTHOR_NAME,
       BC.NO_OF_COPIES, L.PROGRAM_ID
FROM BOOK B, BOOK_AUTHORS BA, BOOK_COPIES BC, LIBRARY_PROGRAMME L
WHERE B.BOOK_ID = BA.BOOK_ID
  AND B.BOOK_ID = BC.BOOK_ID
  AND L.PROGRAM_ID = BC.PROGRAM_ID;

-- Q2. Borrowers who borrowed more than 3 books from Jan 2020 to Jun 2020

SELECT CARD_NO
FROM BOOK_LENDING
WHERE DATE_OUT BETWEEN DATE '2020-01-01' AND DATE '2020-06-01'
GROUP BY CARD_NO
HAVING COUNT(*) > 3;

-- Q3. Delete a book from BOOK; other tables update through ON DELETE CASCADE

DELETE FROM BOOK WHERE BOOK_ID = 3;

SELECT * FROM BOOK;
SELECT * FROM BOOK_AUTHORS;
SELECT * FROM BOOK_COPIES;

-- Q4. Partition the BOOK table by year of publication

CREATE TABLE BOOK_PARTITIONED (
    BOOK_ID         NUMBER(4),
    TITLE           VARCHAR2(100),
    PUBLISHER_NAME  VARCHAR2(100),
    PUB_YEAR        NUMBER(4)
)
PARTITION BY RANGE (PUB_YEAR) (
    PARTITION p1 VALUES LESS THAN (2016),
    PARTITION p2 VALUES LESS THAN (2018),
    PARTITION p3 VALUES LESS THAN (2020),
    PARTITION p4 VALUES LESS THAN (MAXVALUE)
);

