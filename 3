-- ---------- QUERIES ----------

-- (a) Add 5% interest to accounts with balance less than 10000

SELECT * FROM ACCOUNT;

UPDATE ACCOUNT
SET Balance = Balance * 1.05
WHERE Balance < 10000;

SELECT * FROM ACCOUNT;

-- (b) Customers who have at least 2 accounts

SELECT Customer_ID
FROM CUSTOMER_ACCOUNT
GROUP BY Customer_ID
HAVING COUNT(Customer_ID) >= 2;

-- (c) Customers who have not done any transaction

SELECT C.Customer_ID, Name
FROM CUSTOMER C
WHERE C.Customer_ID NOT IN (
    SELECT CA.Customer_ID
    FROM CUSTOMER_ACCOUNT CA
);

-- (e) Classify customers by total balance across all accounts

SELECT C.Customer_ID, Name, SUM(Balance) AS Total_Balance,
    CASE
        WHEN SUM(Balance) < 3000 THEN 'Low Balance'
        WHEN SUM(Balance) <= 10000 THEN 'Medium Balance'
        WHEN SUM(Balance) > 10000 THEN 'High Balance'
    END AS Balance_Category
FROM CUSTOMER C, CUSTOMER_ACCOUNT CA, ACCOUNT A
WHERE C.Customer_ID = CA.Customer_ID
  AND CA.Account_no = A.Account_no
GROUP BY C.Customer_ID, Name;
